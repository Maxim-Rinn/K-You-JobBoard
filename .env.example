# Modèle du fichier .env : copier ce fichier en .env (cp .env.example .env)
# puis remplacer les valeurs propres à votre PC. Le .env n'est JAMAIS commité.

# Port du serveur Express
PORT=3000

# Connexion PostgreSQL (ces noms PG... sont lus automatiquement par la librairie pg)
PGHOST=localhost        # le serveur PostgreSQL tourne sur ce PC
PGPORT=5432             # port par défaut de PostgreSQL
PGDATABASE=jobboard     # base créée avec : sudo -u postgres createdb jobboard
PGUSER=postgres         # utilisateur PostgreSQL
PGPASSWORD=change_moi   # VOTRE mot de passe (ALTER USER ... PASSWORD), différent sur chaque PC

# Clé secrète qui signe les jetons de connexion (JWT) : une longue chaîne aléatoire,
# différente sur chaque PC. La générer avec : openssl rand -hex 32
JWT_SECRET=change_moi_par_une_longue_chaine_aleatoire
