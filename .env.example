# Modèle du fichier .env : copier ce fichier en .env (cp .env.example .env)
# puis remplacer les valeurs propres à votre PC. Le .env n'est JAMAIS commité.

# Port du serveur Express
PORT=3000

# Connexion PostgreSQL, utilisée par DEUX outils :
#  - la librairie pg (db/index.js) lit ces PG... pour se connecter ;
#  - docker compose les lit aussi pour CRÉER la base au 1er « docker compose up -d »
#    (voir docker-compose.yml : POSTGRES_USER=${PGUSER}, etc.).
# Donc pas de createdb ni d'ALTER USER à faire : c'est Docker qui crée tout.
PGHOST=localhost        # Docker publie le port du conteneur sur ce PC
PGPORT=5432             # 5433 si un PostgreSQL local occupe déjà 5432 (changer aussi docker-compose.yml)
PGDATABASE=jobboard     # base créée automatiquement par Docker
PGUSER=postgres         # utilisateur créé automatiquement par Docker
PGPASSWORD=change_moi   # choisissez-le AVANT le 1er lancement ; pour le changer ensuite :
                        # docker compose down -v, puis up -d (efface les données, refaire npm run seed)

# Clé secrète qui signe les jetons de connexion (JWT) : une longue chaîne aléatoire,
# différente sur chaque PC. La générer avec : openssl rand -hex 32
JWT_SECRET=change_moi_par_une_longue_chaine_aleatoire
